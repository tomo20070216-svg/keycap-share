# このファイルをコピーして .env.local を作り、実際の値を入れてください。
# .env.local は .gitignore で除外されているため、Gitにはコミットされません。

# Supabase Project Settings > API Keys で確認できます
# NEXT_PUBLIC_SUPABASE_ANON_KEY には「Publishable key」(旧称: anon public key)の値を入れてください。
# 「Secret key」(旧称: service_role key)は絶対にここに入れないでください(NEXT_PUBLIC_はブラウザに漏れます)。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
